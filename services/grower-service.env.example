# grower-service inside the "growercare" Docker network (container hostnames). DEV-ONLY values.
DB_URL=jdbc:postgresql://postgres:5432/gc_grower
DB_APP_USER=gc_grower_app
DB_APP_PASSWORD=dev_grower_app_pw
GC_CDC_ROLE=gc_cdc
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/token
IAM_BASE_URL=http://identity-access-service:8081
NOTIFICATION_BASE_URL=http://notification-service:8085
IAM_CLIENT_ID=grower-service
IAM_CLIENT_SECRET=dev-grower-service-secret
GC_INTERNAL_CLIENTS=case-service
REDIS_HOST=redis
REDIS_PASSWORD=dev_redis_pw
GC_PHONE_HMAC_KEY=ZGV2LW9ubHktcGhvbmUtaG1hYy1rZXktMzItYnl0ZXM=
GC_PHONE_ENC_KEY=ZGV2LW9ubHktcGhvbmUtZW5jcnlwdGlvbi1rZXktMzI=
GC_PHONE_ENC_KEY_ID=dev-1
GC_MIGRATE=true
DB_OWNER_USER=gc_grower_owner
DB_OWNER_PASSWORD=dev_grower_owner_pw
GC_DEV_SEED=true
GC_MIGRATE_PARALLELISM=8
SERVER_PORT=8084
DB_POOL_SIZE=20
REDIS_PORT=6379
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
GC_API_DOCS_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx512m
