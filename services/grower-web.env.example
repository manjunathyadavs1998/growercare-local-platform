# grower-web (nginx image, SPEC-FE-01 D10) inside the "growercare" Docker network. DEV-ONLY values.
# The browser opens http://localhost:5173; nginx serves the app, writes /config.json from these variables and
# proxies /api to the edge gateway (one origin, no CORS for the API).

# Keycloak realm as the BROWSER reaches it (the sign-in redirect and the token calls)
OIDC_AUTHORITY=http://localhost:8180/realms/growercare
# the app's own public PKCE client (keycloak/configure-web-clients.sh)
OIDC_CLIENT_ID=grower-web
# the edge gateway as nginx reaches it
API_UPSTREAM=http://gc-edge:8080
# further origins the browser may call (CSP connect-src): the object store for presigned uploads and downloads
CONNECT_EXTRA=http://localhost:8333
