# notification-service inside the "growercare" Docker network (container hostnames). DEV-ONLY values.
# Local only: GC_DEV_MAILBOX stores messages instead of sending them (SPEC-NOT-01 D3).

# --- required (no defaults; the service refuses to start without them)
# JDBC URL of the gc_notification database
DB_URL=jdbc:postgresql://postgres:5432/gc_notification
# runtime role (DML only) and its password (secret)
DB_APP_USER=gc_notification_app
DB_APP_PASSWORD=dev_notification_app_pw
# expected token issuer (iss claim) and where signing keys are fetched
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
# Keycloak clients allowed to send messages (SPEC-NOT-01 R7)
GC_INTERNAL_CLIENTS=grower-service
# case notifications (SPEC-NOT-02): case events, contacts from grower-service and IAM, links in the messages
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
GROWER_BASE_URL=http://grower-service:8084
IAM_BASE_URL=http://identity-access-service:8081
# notification-service's own Keycloak client (client credentials, audience gc-internal)
OIDC_TOKEN_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/token
SERVICE_CLIENT_ID=notification-service
SERVICE_CLIENT_SECRET=dev-notification-service-secret
GC_GROWER_APP_URL=http://localhost:5173
GC_STAFF_APP_URL=http://localhost:5174
# SPEC-NOT-02 D9, LOCAL ONLY: a 20 s batching window, no quiet hours, release every 5 s, so J7 (smoke, Playwright)
# completes in seconds at any hour. Elsewhere leave them unset (5 minutes, quiet hours 21:00-07:00, every 15 s).
GC_CASE_NOTICE_WINDOW=PT20S
GC_CASE_NOTICE_QUIET_HOURS=false
GC_CASE_NOTICE_RELEASE_INTERVAL_MS=5000

# --- providers (SPEC-NOT-01 D2/D3): LOCAL ONLY, messages are stored in the dev mailbox instead of being sent
# default false; never true where real providers are configured
GC_DEV_MAILBOX=true
GC_SMS_PROVIDER=mailbox
GC_WHATSAPP_PROVIDER=mailbox
GC_EMAIL_PROVIDER=mailbox

# --- migrations (only where they run: locally, or the pre-deploy Job)
# default false
GC_MIGRATE=true
DB_OWNER_USER=gc_notification_owner
DB_OWNER_PASSWORD=dev_notification_owner_pw

# --- optional tunables (safe defaults)
SERVER_PORT=8085
DB_POOL_SIZE=10
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
GC_API_DOCS_ENABLED=true
# lean local JVM: all six services on one laptop next to the infrastructure (the VM has 10 GB)
JAVA_TOOL_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k
