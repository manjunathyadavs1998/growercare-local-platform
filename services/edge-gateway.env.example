# edge-gateway inside the "growercare" Docker network (container hostnames). DEV-ONLY values (SPEC-EDGE-01).
# Values below are DEV-ONLY and target the growercare-local-platform network (container hostnames).
# Production: injected from AWS Secrets Manager via External Secrets (never committed).

# --- required (no defaults; the gateway refuses to start without them)
# expected token issuer (iss claim) and where signing keys are fetched
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
# the services behind the routes (SPEC-EDGE-01 D2)
IAM_BASE_URL=http://identity-access-service:8081
CASE_BASE_URL=http://case-service:8082
GROWER_BASE_URL=http://grower-service:8084
CATALOG_BASE_URL=http://catalog-registry-service:8086
# rate-limit buckets (secret)
REDIS_HOST=redis
REDIS_PASSWORD=dev_redis_pw

# --- optional tunables (safe defaults)
SERVER_PORT=8080
REDIS_PORT=6379
# default: none (no browser origin allowed)
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# default none; "native" only behind a proxy that sets X-Forwarded-For (ALB)
GC_FORWARD_HEADERS_STRATEGY=none
JAVA_TOOL_OPTIONS=-Xmx256m
