# identity-access-service inside the "growercare" Docker network (container hostnames). DEV-ONLY values.
SERVER_PORT=8081
DB_URL=jdbc:postgresql://postgres:5432/gc_iam
DB_APP_USER=gc_iam_app
DB_APP_PASSWORD=dev_iam_app_pw
DB_OWNER_USER=gc_iam_owner
DB_OWNER_PASSWORD=dev_iam_owner_pw
GC_CDC_ROLE=gc_cdc
GC_MIGRATE=true
GC_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev-seed
GC_FLYWAY_OUT_OF_ORDER=true
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
GC_INTERNAL_CLIENTS=case-service,grower-service,catalog-registry-service,notification-service
# of those, the clients that may read staff/partner contacts (SPEC-IAM-05 D2)
GC_CONTACT_CLIENTS=notification-service
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
GC_API_DOCS_ENABLED=true
# lean local JVM: all six services on one laptop next to the infrastructure (the VM has 10 GB)
JAVA_TOOL_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k
