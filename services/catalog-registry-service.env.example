# catalog-registry-service inside the "growercare" Docker network (container hostnames). DEV-ONLY values.

# --- required (no defaults; the service refuses to start without them)
# JDBC URL of the gc_catalog database
DB_URL=jdbc:postgresql://postgres:5432/gc_catalog
# runtime role (DML only) and its password (secret)
DB_APP_USER=gc_catalog_app
DB_APP_PASSWORD=dev_catalog_app_pw
# Debezium's login role: it may read the outbox only
GC_CDC_ROLE=gc_cdc
# expected token issuer (iss claim), signing keys, and where service tokens come from
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/token
# identity-access-service and this service's client credentials for it (secret)
IAM_BASE_URL=http://identity-access-service:8081
IAM_CLIENT_ID=catalog-registry-service
IAM_CLIENT_SECRET=dev-catalog-registry-service-secret
# Redis (principal cache) and its password (secret)
REDIS_HOST=redis
REDIS_PASSWORD=dev_redis_pw
# service clients allowed on /internal/** (SPEC-CAT-01 R16, R20)
GC_INTERNAL_CLIENTS=erp-sync,case-service
# of those, the ones that may write the catalog (SPEC-CAT-01 D2)
GC_IMPORT_CLIENTS=erp-sync

# --- migrations (only where they run: locally, or the pre-deploy Job)
# default false
GC_MIGRATE=true
DB_OWNER_USER=gc_catalog_owner
DB_OWNER_PASSWORD=dev_catalog_owner_pw
# local only: the dev seed (products 9001-9004) and out-of-order for later migrations
GC_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev-seed
GC_FLYWAY_OUT_OF_ORDER=true

# --- optional tunables (safe defaults)
SERVER_PORT=8086
DB_POOL_SIZE=10
REDIS_PORT=6379
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
GC_API_DOCS_ENABLED=true
# lean local JVM: all six services on one laptop next to the infrastructure (the VM has 10 GB)
JAVA_TOOL_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k
